# Which provider marks the papers: "gemini" or "openrouter".
# Leave it unset and the app uses whichever API key it finds below.
# AI_PROVIDER=gemini

# --- Gemini — get one free at https://aistudio.google.com/apikey ----------
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Optional — 0 turns thinking off. Unset: flash models default to 0, pro decides.
# GEMINI_THINKING_BUDGET=0

# --- OpenRouter — get a key at https://openrouter.ai/keys -----------------
# OPENROUTER_API_KEY=

# Optional — defaults to google/gemini-2.5-flash (reads PDFs and photos)
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional — tried when the primary fails outright (rate limit, no credit for
# PDFs, model delisted). Defaults to openrouter/free; set to "" to disable.
# OPENROUTER_FALLBACK_MODEL=openrouter/free

# Free tier: openrouter/free routes across the free models. No credit needed and
# PDFs work, but expect rate limits (~20/min, ~50/day) and slower, less
# consistent marking — it rotates between models on every request.
# OPENROUTER_MODEL=openrouter/free

# Optional — per-request timeout in ms (default 55000). Keep it under the
# route's maxDuration.
# AI_TIMEOUT_MS=55000

# Optional — none | minimal | low | medium | high. Unset uses the model default.
# OPENROUTER_REASONING=

# Optional — attribution on your OpenRouter activity page
# OPENROUTER_APP_NAME=MarkGuide
# OPENROUTER_SITE_URL=https://your-deployment.vercel.app
